unit m5_runtime;

fn take(p: ^i32) -> void { mem.destroy(p); }

pub fn run(mode: i32) -> i32 {
    var p: ^i32 = try mem.create(i32);
    defer { mem.destroy(p); }
    p.^ = 7;
    if mode == 1 {
        p = try mem.create(i32);
        p.^ = 9;
        return p.^;
    }
    while true { break; }
    if mode == 2 { return 0; }
    return p.^ - 7;
}

pub fn conditional(flag: bool) -> void {
    var p: ^i32 = try mem.create(i32);
    if flag { take(p); }
}

pub fn argument_cleanup() -> void {
    let p: ^i32 = try mem.create(i32);
    take(p);
}

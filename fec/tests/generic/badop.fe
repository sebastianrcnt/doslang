// ERROR:11:ordering requires
// SPEC 9: the primary error is the comparison in the body. The call at the
// bottom gets an `instantiated here` note.
unit badop;

struct Token {
    value: i32,
}

fn max(comptime T: type, a: T, b: T) -> T {
    if a > b { return a; }
    return b;
}

fn bad() -> Token {
    let a = Token{ value: 1 };
    let b = Token{ value: 2 };
    return max(Token, a, b);
}
